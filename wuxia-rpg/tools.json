{
  "protocol_version": "1.9",
  "tools": [
    {
      "name": "wuxia_go",
      "operation": "go",
      "title": "武侠 go",
      "description": "武侠RPG 玩家主动指令的机制结算（go）。普通回合无界面后按需 check/random-event，提交一次 plot-writing，再按需各调用一次 prepare，最后 judge。不重复 go。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号；开始游戏传0，创建角色传开始游戏返回的next_slot"
          },
          "行为": {
            "type": "array",
            "description": "go 行为数组；所有行动均受已确定的剧情约束阻止时传空数组，随后继续 plot-writing → judge",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "槽位",
          "行为"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "界面": {
            "type": "string"
          },
          "渲染模式": {
            "type": "string",
            "description": "归一渲染模式：dsh/WEB_UI/LLM（未设置为 LLM）"
          },
          "渲染文本": {
            "type": "string",
            "description": "界面完整 Markdown（仅 LLM 渲染模式返回）；GM 有则原样输出、不改写或润色，包括空字符串；无（dsh/WEB_UI 由前端渲染）则直接输出当前剧情"
          },
          "错误": {
            "type": "string"
          },
          "错误码": {
            "type": "string",
            "description": "业务错误稳定标识，如slot_occupied"
          },
          "next_slot": {
            "type": "integer",
            "description": "开始游戏或创建槽位冲突时返回的最新可用槽位"
          },
          "状态冲突": {
            "type": "string",
            "description": "阶段门禁冲突的稳定标识"
          },
          "turn_state": {
            "type": "string",
            "description": "当前 go/judge 阶段"
          }
        }
      }
    },
    {
      "name": "wuxia_judge",
      "operation": "judge",
      "title": "武侠 judge",
      "description": "武侠RPG 裁定落盘（judge）。普通回合自动采用本轮全部场景与任务草稿，judge 只传槽位；战斗另走专用流程。失败不重跑 go。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号"
          },
          "行为": {
            "type": "array",
            "description": "仅战斗沿用的 action 数组；普通回合不得传",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "当前剧情": {
            "type": "string",
            "description": "仅战斗裁定沿用的剧情"
          }
        },
        "required": ["槽位"]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "界面": {
            "type": "string"
          },
          "渲染模式": {
            "type": "string",
            "description": "归一渲染模式：dsh/WEB_UI/LLM（未设置为 LLM）"
          },
          "渲染文本": {
            "type": "string",
            "description": "界面完整 Markdown（仅 LLM 渲染模式返回）；GM 有则原样输出、不改写或润色，包括空字符串；无（dsh/WEB_UI 由前端渲染）则直接输出当前剧情"
          },
          "错误": {
            "type": "string"
          },
          "状态冲突": {
            "type": "string",
            "description": "阶段门禁冲突的稳定标识"
          },
          "turn_state": {
            "type": "string",
            "description": "当前 go/judge 阶段"
          }
        }
      }
    },
    {
      "name": "wuxia_plot_writing",
      "operation": "plot-writing",
      "title": "武侠 plot writing",
      "description": "武侠RPG 普通回合剧情与状态变更。go 无界面、必要 check/random-event 后提交一次；通过校验后本轮不得修改，随后按需 prepare，最后只传槽位调 judge。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {"type": "integer", "description": "当前存档槽位号"},
          "行为": {
            "type": "array",
            "description": "本轮状态变更 action 数组；无变更可省略",
            "items": {"type": "object", "additionalProperties": true}
          },
          "当前剧情": {"type": "string", "description": "本回合剧情；必填"},
          "场景要素": {
            "type": "array",
            "description": "本轮可见的人/物/环境要素；须非空，无变化也重报现状",
            "minItems": 1,
            "items": {"type": "object", "additionalProperties": true}
          },
          "经历概括": {"type": "string", "description": "经历概括"},
          "提及地点": {
            "type": "array",
            "description": "本轮叙事新提及、玩家可前往的「区域·场景」全名；可为空数组",
            "items": {"type": "string"}
          }
        },
        "required": ["槽位", "当前剧情", "场景要素", "提及地点"]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "ok": {"type": "boolean"},
          "错误": {"type": "string"},
          "状态冲突": {"type": "string"},
          "turn_state": {"type": "string"}
        }
      }
    },
    {
      "name": "wuxia_check",
      "operation": "check",
      "title": "武侠 check",
      "description": "武侠RPG 判定掷骰。普通 go 无界面后、首次 plot-writing 前按需调用；结果暂存留痕，剧情须高亮带入判定结果。判断随机事件请用 wuxia_random_event。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号"
          },
          "属性": {
            "type": "array",
            "description": "判定属性名数组（多属性取均值）",
            "items": {
              "type": "string"
            }
          },
          "判定角色": {
            "type": "array",
            "description": "判定角色名数组（多角色取均值）",
            "items": {
              "type": "string"
            }
          },
          "对抗": {
            "type": "string",
            "description": "角色名（可逗号多个）或以 @ 开头的数值"
          },
          "基础成功率": {
            "type": "number",
            "description": "基础成功率 0~100，缺省50"
          }
        },
        "required": [
          "槽位"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "结果": {
            "type": "string"
          },
          "提示": {
            "type": "string"
          },
          "错误": {
            "type": "string"
          },
          "状态冲突": {
            "type": "string",
            "description": "阶段门禁冲突的稳定标识"
          },
          "turn_state": {
            "type": "string",
            "description": "当前 go/judge 阶段"
          }
        }
      }
    },
    {
      "name": "wuxia_random_event",
      "operation": "random-event",
      "title": "武侠 random-event",
      "description": "武侠RPG 随机事件判定。普通 go 无界面后、首次 plot-writing 前按需调用；返回触发/未触发，结果暂存供本轮重试复用。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号"
          },
          "基础成功率": {
            "type": "number",
            "description": "基础触发率 0~100，缺省15"
          }
        },
        "required": [
          "槽位"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "结果": {
            "type": "string"
          },
          "提示": {
            "type": "string"
          },
          "错误": {
            "type": "string"
          },
          "状态冲突": {
            "type": "string",
            "description": "阶段门禁冲突的稳定标识"
          },
          "turn_state": {
            "type": "string",
            "description": "当前 go/judge 阶段"
          }
        }
      }
    },
    {
      "name": "wuxia_scene_prepare",
      "operation": "scene-prepare",
      "title": "武侠 scene prepare",
      "description": "武侠RPG plot-writing 成功后，按需一次性准备场景登记、隔离或重连。通过校验后本轮不得修改，全部草稿由只传槽位的 judge 自动采用。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号"
          },
          "场景": {
            "type": "array",
            "description": "本轮一次性场景规划批次；通过校验后不得覆盖",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "操作": {
                  "type": "string",
                  "description": "登记 / 隔离 / 重连",
                  "enum": ["登记", "隔离", "重连"]
                },
                "区域": {
                  "type": "string",
                  "description": "须为基线已知区域名（如 苏州/嵩山），未知区域会被打回"
                },
                "场景": {
                  "type": "string"
                },
                "方位出口": {
                  "type": "object",
                  "description": "方位到相邻场景名；目标须为已登记地点（同批次登记顺序不限），登记可省，重连必传非空对象",
                  "additionalProperties": true
                },
                "功能类型": {
                  "type": "string",
                  "description": "登记功能场景时可传：驿站 / 店铺 / 客栈"
                },
                "功能NPC": {
                  "type": "string",
                  "description": "登记功能场景时绑定的身份名"
                }
              },
              "required": ["操作", "区域", "场景"]
            }
          }
        },
        "required": ["槽位", "场景"]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "ok": {"type": "boolean"},
          "场景": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "操作": {"type": "string"},
                "区域": {"type": "string"},
                "场景": {"type": "string"}
              }
            }
          },
          "剩余配额": {"type": "integer"},
          "错误": {"type": "string"},
          "状态冲突": {"type": "string"},
          "turn_state": {"type": "string"}
        }
      }
    },
    {
      "name": "wuxia_quest_prepare",
      "operation": "quest-prepare",
      "title": "武侠 quest prepare",
      "description": "武侠RPG plot-writing 成功后，按需一次性准备任务蓝图。通过校验后本轮不得修改，全部草稿由只传槽位的 judge 自动采用。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号"
          },
          "任务": {
            "type": "array",
            "description": "本轮一次性任务草稿批次，可混合创建、扩展、修改和关闭；通过校验后不得覆盖",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "操作": {
                  "type": "string",
                  "enum": [
                    "创建",
                    "扩展",
                    "修改",
                    "关闭"
                  ]
                },
                "蓝图": {
                  "type": "object",
                  "description": "创建/扩展/修改蓝图；关闭蓝图须含名称与非空描述，可选节点",
                  "additionalProperties": true
                },
                "隐藏": {
                  "type": "boolean",
                  "description": "仅创建可用，缺省false"
                }
              },
              "required": [
                "操作",
                "蓝图"
              ]
            }
          }
        },
        "required": [
          "槽位",
          "任务"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "任务": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "操作": {
                  "type": "string"
                },
                "版本": {
                  "type": "integer"
                },
                "名称": {
                  "type": "string"
                },
                "节点数": {
                  "type": "integer"
                },
                "终局数": {
                  "type": "integer"
                },
                "扩展点数": {
                  "type": "integer"
                },
                "引用事实": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "错误": {
            "type": "string"
          },
          "状态冲突": {
            "type": "string"
          },
          "turn_state": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "wuxia_query",
      "operation": "query",
      "title": "武侠 query",
      "description": "武侠RPG 基础数据查询。查询角色、武学、物品、状态、阵营或场景角色；支持批量名称、字段筛选、角色派生属性和指定等级武学特效。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号；未建档时传0读取基线"
          },
          "类型": {
            "type": "string",
            "description": "角色 / 武学 / 物品 / 状态 / 阵营 / 场景角色"
          },
          "名称": {
            "type": "array",
            "description": "名称数组；不传则列出该类型全部名称",
            "items": {
              "type": "string"
            }
          },
          "派生": {
            "type": "boolean",
            "description": "角色查询是否附带战斗同源派生属性"
          },
          "字段": {
            "type": "array",
            "description": "仅返回指定字段",
            "items": {
              "type": "string"
            }
          },
          "等级": {
            "type": "integer",
            "description": "武学精进等级，缺省1"
          },
          "位置": {
            "type": "string",
            "description": "查询场景角色时传入 区域·场景"
          }
        },
        "required": [
          "槽位",
          "类型"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "wuxia_setting",
      "operation": "setting",
      "title": "武侠 setting",
      "description": "武侠RPG 设定查询。按门派或人物聚合返回门派描述、位置、武学、成员或人物身份、人设、生死与所属门派。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号；未建档时传0读取基线"
          },
          "目标": {
            "type": "string",
            "description": "门派名或人物名"
          }
        },
        "required": [
          "槽位",
          "目标"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "wuxia_recommend",
      "operation": "recommend",
      "title": "武侠 recommend",
      "description": "武侠RPG 自创角色武学推荐。按阵营、四项一级属性和武学偏好返回心法、主动武学与装备推荐。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号；未建档时传0读取基线"
          },
          "姓名": {
            "type": "string",
            "description": "角色姓名，仅作标识"
          },
          "阵营": {
            "type": "string",
            "description": "门派名或江湖/散人，缺省散人"
          },
          "一级属性": {
            "type": "object",
            "description": "内功、力道、身法、根骨四项整数",
            "additionalProperties": false,
            "properties": {
              "内功": {
                "type": "integer"
              },
              "力道": {
                "type": "integer"
              },
              "身法": {
                "type": "integer"
              },
              "根骨": {
                "type": "integer"
              }
            },
            "required": [
              "内功",
              "力道",
              "身法",
              "根骨"
            ]
          },
          "武学偏好": {
            "type": "string",
            "description": "剑法 / 刀法 / 长兵 / 奇门 / 暗器 / 搏击"
          }
        },
        "required": [
          "槽位",
          "一级属性",
          "武学偏好"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "wuxia_map_query",
      "operation": "map-query",
      "title": "武侠 map-query",
      "description": "武侠RPG 地图查询。返回区域内基线/新增场景、方位出口、场景类型、功能NPC、孤点及配额余量；区域传“配额”时列全区域上限。",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "槽位": {
            "type": "integer",
            "description": "当前存档槽位号；未建档时传0读取基线"
          },
          "区域": {
            "type": "string",
            "description": "区域名（支持唯一子串）或“配额”"
          }
        },
        "required": [
          "槽位",
          "区域"
        ]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ]
}
